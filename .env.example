# Server token for reading public events and diffs (a fine-grained token with no permissions is enough).
# Without it, pushes are not ingested and only sparring bots fight.
GITHUB_TOKEN=

# GitHub OAuth app for "Sign in with GitHub". Callback URL: ${PUBLIC_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where browsers reach the app. In dev the Vite server proxies /auth, /api, /hooks and /ws.
PUBLIC_URL=http://localhost:5173

# HMAC key for the session cookie. Required (32+ chars) in production.
SESSION_SECRET=

PORT=8787
HOST=0.0.0.0
DATABASE_PATH=data/pushfront.db
CLIENT_DIR=dist/client

# Seed "The Commons", a public room with sparring bots.
COMMONS=1
MAX_ROOMS_PER_USER=5
MAX_LIVE_ROOMS=200

# Local testing: sign in as any login at /auth/dev?login=<login>, and run wars of a few minutes instead of a day.
DEV_AUTH=0
# DAY_MINUTES=10
