# Copy to .env (`cp .env.example .env`) and fill in what you need. Everything is optional in development.

# ---- GitHub access -------------------------------------------------------------------------------
# Server token for reading public events, diffs and blame. Strongly recommended, even locally:
#   without it GitHub allows 60 anonymous requests an hour (about four army previews), real pushes are
#   not ingested (only sparring bots fight) and the difficulty bonus has no GraphQL.
# Create one at https://github.com/settings/personal-access-tokens/new: a fine-grained token,
# "Public repositories (read-only)", no extra permissions. That gives 5,000 requests an hour.
GITHUB_TOKEN=

# GitHub OAuth app for "Sign in with GitHub" (https://github.com/settings/applications/new).
# Callback URL: ${PUBLIC_URL}/auth/github/callback. Pushfront requests no scopes.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Server --------------------------------------------------------------------------------------
# Where browsers reach the app. In dev the Vite server proxies /auth, /api, /hooks and /ws.
PUBLIC_URL=http://localhost:5173

# HMAC key for the session cookie. Required (32+ chars) in production; random per boot otherwise.
SESSION_SECRET=

PORT=8787
HOST=0.0.0.0
DATABASE_PATH=data/pushfront.db
CLIENT_DIR=dist/client

# ---- Rooms ---------------------------------------------------------------------------------------
# Seed "The Commons", a public room with sparring bots.
COMMONS=1
MAX_ROOMS_PER_USER=5
MAX_LIVE_ROOMS=200

# ---- Ingestion -----------------------------------------------------------------------------------
# Local git mirrors, the difficulty bonus's fallback when GraphQL can't answer (source files only,
# repos up to 50 MB, pruned after 14 idle days). Needs git on the PATH. Leave empty for no mirrors.
MIRROR_DIR=
# Worker threads that parse pushes with tree-sitter; 0 parses on the main thread. Unset: up to 2.
# PARSE_WORKERS=2

# ---- Client --------------------------------------------------------------------------------------
# 0 is the service worker's kill switch: pages unregister it and drop their caches.
SERVICE_WORKER=1

# ---- Local testing -------------------------------------------------------------------------------
# Sign in as any login at /auth/dev?login=<login> (refused in production).
DEV_AUTH=0
# Run wars of this many minutes instead of a day.
# DAY_MINUTES=10
