{
  "name": "codeclash",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "build": "vite build && esbuild src/server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/main.js && esbuild src/ingest/parseWorker.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/parseWorker.js",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "test:fast": "vitest run --exclude 'src/game/game-*.test.ts' --exclude 'src/server/league.test.ts' --exclude 'src/measure/gaming.test.ts' --exclude 'src/game/doctrine.test.ts' --exclude 'src/game/behaviour.test.ts' --exclude 'src/game/crossing.test.ts' --exclude 'src/game/cohesion.test.ts' --exclude 'src/game/battle.test.ts' --exclude 'src/game/undead.test.ts' --exclude 'src/client/render/downscale.test.ts' --exclude 'src/client/render/paper/skin-memo.test.ts' --exclude 'src/client/render/paper/determinism.test.ts'",
    "typecheck": "tsc --noEmit",
    "grammars": "tsx scripts/vendor-grammars.ts",
    "bench": "tsx scripts/battle-bench.ts",
    "fairness": "tsx scripts/battle-fairness.ts",
    "battle-stats": "tsx scripts/battle-stats.ts",
    "pixel-lint": "tsx scripts/pixel-lint.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5",
    "react": "^19",
    "react-dom": "^19",
    "web-tree-sitter": "0.26.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@9.10.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
